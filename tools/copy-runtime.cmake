file(COPY "${SOURCE}/web" DESTINATION "${APP}")
file(MAKE_DIRECTORY "${APP}/deploy")
foreach(FILE install-service.bat start-service.bat stop-service.bat restart-service.bat uninstall-service.bat open_firewall.bat remove_firewall.bat service.ps1 service-native.cs diagnose-service.ps1 firewall.ps1 import_android.ps1 README.md)
  file(COPY "${SOURCE}/deploy/${FILE}" DESTINATION "${APP}/deploy")
endforeach()
if(EXISTS "${SOURCE}/tools/ffmpeg/ffmpeg.exe")
  file(COPY "${SOURCE}/tools/ffmpeg" DESTINATION "${APP}/tools")
endif()
file(MAKE_DIRECTORY "${APP}/config")
if(NOT EXISTS "${APP}/config/server.json")
  file(COPY "${SOURCE}/config/server.json" DESTINATION "${APP}/config")
endif()
